# نمونه‌ی متغیرهای پروداکشن — روی سرور این را به .env کپی کن و مقادیر واقعی بگذار.
# فایل .env واقعی هرگز کامیت نمی‌شود (در .gitignore).
#   cp .env.production.example .env  &&  nano .env

# ── MySQL ────────────────────────────────────────────────
DB_ROOT_PASSWORD=change_me_strong_root_password
DB_DATABASE=roohbakhshac
DB_USERNAME=roohbakhsh
DB_PASSWORD=change_me_strong_db_password

# ── JWT ──────────────────────────────────────────────────
# یک رشته‌ی تصادفی بلند بگذار:  openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_string

# ── ایمیل (Resend) ───────────────────────────────────────
# اگر خالی بماند، ایمیل‌ها فقط در لاگ چاپ می‌شوند (ارسال واقعی ندارند).
RESEND_API_KEY=
MAIL_FROM=Roohbakhsh Academy <onboarding@resend.dev>

# ── ZarinPal (فعلاً placeholder — درگاه ایرانی، برای مخاطب بین‌الملل بعداً تعیین شود) ──
ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000

# ── پرداخت کارت‌به‌کارت (قابل ویرایش از پنل CMS هم هست) ──
PAYMENT_DESTINATION_CARD_NUMBER=0000-0000-0000-0000
PAYMENT_DESTINATION_ACCOUNT_NUMBER=0000000000
PAYMENT_DESTINATION_ACCOUNT_HOLDER=Roohbakhsh Academy
PAYMENT_DESTINATION_BANK_NAME=Bank
